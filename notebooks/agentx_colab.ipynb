# Early Warning System for Students at Risk - AgentX Hackathon

import pandas as pd

data = {
    "student_id": ["S001", "S002", "S003", "S004", "S005"],
    "student_name": ["Student A", "Student B", "Student C", "Student D", "Student E"],
    "attendance": [42, 68, 91, 73, 86],
    "marks": [38, 55, 84, 47, 72],
    "assignments": [30, 60, 95, 45, 80]
}

df = pd.DataFrame(data)

def analyze_student(row):
    score = (
        row["attendance"] * 0.35
        + row["marks"] * 0.40
        + row["assignments"] * 0.25
    )

    if score < 45 or (row["attendance"] < 50 and row["marks"] < 50):
        risk = "High"
    elif (
        score < 65
        or row["attendance"] < 75
        or row["marks"] < 50
        or row["assignments"] < 50
    ):
        risk = "Medium"
    else:
        risk = "Low"

    suggestions = []

    if row["attendance"] < 75:
        suggestions.append("Improve attendance")
    if row["marks"] < 50:
        suggestions.append("Attend extra coaching")
    if row["assignments"] < 70:
        suggestions.append("Complete pending assignments")
    if not suggestions:
        suggestions.append("Maintain current performance")

    return pd.Series({
        "weighted_score": round(score, 2),
        "risk_level": risk,
        "support_plan": "; ".join(suggestions)
    })

df[["weighted_score", "risk_level", "support_plan"]] = df.apply(
    analyze_student, axis=1
)

print("EARLY WARNING SYSTEM FOR STUDENTS AT RISK")
print("=" * 55)
print(df.to_string(index=False))

print("\nRISK SUMMARY")
print(df["risk_level"].value_counts().to_string())

df.to_csv("student_risk_results.csv", index=False)
print("\nResults saved to student_risk_results.csv")
